# Copy this file to .env and set your project ID:
#   cp .env.example .env
GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>

# Gemini 3 models (gemini-3-flash-preview, gemini-3.1-pro-preview) are served
# from the "global" location. With us-central1 (the codelab's value) the first
# model call returns 404.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Model per agent (codelab defaults). If your project has no access to the
# preview models, try gemini-2.5-flash for all three.
PLANNER_MODEL=gemini-3-flash-preview
EVALUATOR_MODEL=gemini-3.1-pro-preview
SIMULATOR_MODEL=gemini-3-flash-preview

# Evaluator: "vertex" uses the 6 LLM judges of Vertex AI Evaluation;
# "heuristic" skips them (useful live when evaluation is slow or failing).
EVALUATOR_MODE=vertex

# Full Team mode: connect the Planner to the Simulator over A2A
# SIMULATOR_AGENT_RESOURCE_NAME=local:8089

# Only when deploying to Agent Engine (enables Sessions + Memory Bank).
# Agent Engine is regional: do NOT use "global" here.
# AGENT_ENGINE_ID=
# AGENT_ENGINE_LOCATION=us-central1
